rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only backend (Cloud Functions/Admin SDK) can write anywhere.
    // Clients can read data but not write directly.
    
    match /orders/{orderId} {
      allow read: if true; // In a production app with Auth, restrict to request.auth.uid
      allow write: if false; 
    }
    
    match /customers/{customerId} {
      allow read: if true; 
      allow write: if false;
    }
    
    match /paymentEvents/{eventId} {
      allow read: if false; // Private logs
      allow write: if false;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
